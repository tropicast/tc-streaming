# TLS gateway for the streaming node (#6). Caddy is the only public entry
# point; Icecast stays on the internal Docker network.
{
	email {$ACME_EMAIL}
	{$CADDY_GLOBAL_OPTIONS}

	# Broadcasters on INGEST_HOST bypass HTTP handling. Icecast source
	# clients (the desktop app, BUTT, Mixxx, FFmpeg's icecast://) send PUT or
	# SOURCE with no Content-Length and stream until they disconnect. An HTTP
	# proxy forwards no body for such a request, so the layer4 module
	# decrypts TLS and passes the raw connection to Icecast. Only a
	# PUT/SOURCE request line for a station mount is passed on; any other
	# connection to INGEST_HOST is closed. Connections for other hostnames
	# fall through to the normal HTTPS server below.
	servers :443 {
		listener_wrappers {
			layer4 {
				@ingest tls sni {$INGEST_HOST}
				route @ingest {
					# HTTP/1.1 only: Icecast does not speak HTTP/2.
					tls {
						connection_policy {
							alpn http/1.1
						}
					}
					subroute {
						@source http {
							method PUT SOURCE
							path_regexp ^/stations/[A-Za-z0-9-]{1,64}/live\.(mp3|opus)$
						}
						route @source {
							proxy icecast:8000
						}
						route {
							close
						}
					}
				}
			}
			tls
		}
	}
}

(common) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Access log without query strings or credentials.
	log {
		output stdout
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>uri regexp \?.* ""
		}
	}
}

# Listeners: GET a station stream; everything else is hidden.
{$LISTEN_HOST} {
	import common

	@stream {
		method GET HEAD OPTIONS
		path_regexp ^/stations/[A-Za-z0-9-]{1,64}/live\.(mp3|opus)$
	}

	handle @stream {
		header {
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Expose-Headers "icy-br, icy-name, icy-description, icy-genre, icy-metaint"
		}
		@preflight method OPTIONS
		respond @preflight 204

		reverse_proxy icecast:8000 {
			# Send audio as it arrives; never buffer the response.
			flush_interval -1
		}
	}

	handle {
		respond 404
	}
}

# Broadcasters. HTTPS connections are handled by the layer4 route in the
# global options; this site block only gives Caddy a certificate for the
# host and answers plain HTTP.
{$INGEST_HOST} {
	import common
	respond 404
}
