<?xml version="1.0" encoding="UTF-8"?>
<!-- Production config for a shared multi-tenant origin node (issue #5).
     Passwords and <hostname> are filled in at startup by
     docker-entrypoint.py; never commit real values here. -->
<icecast>
    <location>Tropicast</location>
    <admin>ops@tropicast.invalid</admin>
    <hostname>localhost</hostname>

    <!-- Sized for one Hetzner CX33 (4 vCPU, 8 GB, 20 TB/month egress).
         20 TB/month sustained is about 62 Mbit/s: roughly 960 listeners at
         64 kbps or 480 at 128 kbps around the clock. Peaks may go higher
         because the quota is monthly. Revisit after the load test (#12). -->
    <limits>
        <!-- All connections: listeners, sources and admin requests. -->
        <clients>1500</clients>
        <!-- Station mounts on this node: 50 live, plus 16 AutoDJ mounts
             (8 AutoDJ stations x MP3 + Opus, #65). The control plane's
             STREAMING_MAX_SOURCES must equal it. -->
        <sources>66</sources>
        <!-- Per-listener backlog before a slow client is dropped
             (512 KiB is about 65 s at 64 kbps). -->
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <!-- Drop a silent source after 3 s: a DJ whose connection died
             (no FIN, e.g. a lost uplink) hands over to AutoDJ that soon, and
             the desktop app reconnects (#85). Its encoder sends audio,
             silence included, many times a second. -->
        <source-timeout>3</source-timeout>
        <!-- Initial burst for mounts without a station bitrate cap: 0.5 s at
             128 kbps, 1 s at 64 kbps. A listener stays one burst behind the
             source, so it is delay (#85, docs/reference/latency.md). Station
             mounts get theirs from docker-entrypoint.py (BURST_SECONDS). -->
        <burst-size>8192</burst-size>
    </limits>

    <authentication>
        <!-- Global source password: internal break-glass only. Never give
             it to customers. -->
        <source-password />
        <!-- Relay password: generated per node unless supplied. -->
        <relay-password />
        <admin-user>admin</admin-user>
        <admin-password />
    </authentication>

    <!-- Station-scoped source authentication (#7). Every mount without its
         own <mount type="normal"> uses this default, so each publish is
         checked by the control plane. docker-entrypoint.py fills in the
         endpoint URL and the credentials Icecast uses to call it.
         Icecast denies the source when the endpoint refuses, errors or
         does not answer within its built-in 15 s timeout.
         The global source password is not accepted on these mounts. -->
    <mount type="default">
        <authentication>
            <role type="url" match-method="source,put" allow-method="source,put" allow-web="*" allow-admin="metadata">
                <option name="client_add" value="" />
                <option name="action_add" value="stream_auth" />
                <option name="username" value="" />
                <option name="password" value="" />
                <!-- Declared bitrate and format, so the endpoint can enforce
                     the station's plan (#8). Sent as header.ice-bitrate etc. -->
                <option name="headers" value="ice-bitrate,ice-audio-info,content-type" />
                <option name="header_prefix" value="header." />
                <!-- New-style answer headers only (x-icecast-auth-result: ok);
                     unset, Icecast accepts old and new and warns at each load. -->
                <option name="header_auth" value="x-icecast-auth-result" />
                <option name="header_timelimit" value="x-icecast-auth-timelimit" />
            </role>
            <!-- ICY metadata updates on a station mount (#72): MP3 sources
                 send track titles apart from the audio, as
                 GET /admin/metadata?mount=...&mode=updinfo&song=... with
                 their own credentials. Only that admin command matches, never
                 a listener's GET; the endpoint checks the credentials as for
                 the source (action metadata_auth). -->
            <role type="url" match-method="get" nomatch-web="*" match-admin="metadata" nomatch-admin="*" allow-admin="metadata">
                <option name="client_add" value="" />
                <option name="action_add" value="metadata_auth" />
                <option name="username" value="" />
                <option name="password" value="" />
                <option name="header_auth" value="x-icecast-auth-result" />
                <option name="header_timelimit" value="x-icecast-auth-timelimit" />
            </role>
            <role type="anonymous" match-method="source,put" deny-all="*" />
        </authentication>
    </mount>

    <!-- Icecast listens on all interfaces inside the container only.
         The container port is never published to the internet: Caddy is
         the only public entry point (#6) and the host firewall keeps
         port 8000 closed (#3). -->
    <listen-socket>
        <port>8000</port>
        <bind-address>0.0.0.0</bind-address>
    </listen-socket>

    <!-- No static file serving from webroot; status pages still work for
         the private healthcheck and metrics. -->
    <fileserve>0</fileserve>

    <paths>
        <basedir>/usr/local/share/icecast</basedir>
        <logdir>/run/icecast</logdir>
        <webroot>/usr/local/share/icecast/web</webroot>
        <adminroot>/usr/local/share/icecast/admin</adminroot>
        <reportxmldb>/usr/local/share/icecast/report-db.xml</reportxmldb>
        <pidfile>/run/icecast/icecast.pid</pidfile>
        <!-- ICY metadata updates (MP3 track titles) arrive as GET
             /admin/metadata from Liquidsoap, BUTT, Mixxx…: none can use
             POST. Legacy mode accepts that without a warning per title;
             only this path, everything else keeps the strict default. -->
        <resource source="/admin/metadata" omode="legacy" />
    </paths>

    <!-- Both logs go to stdout for Docker. The access log records the
         source username, never the password. -->
    <logging>
        <accesslog>-</accesslog>
        <errorlog>-</errorlog>
        <loglevel>information</loglevel>
    </logging>

    <security>
        <chroot>false</chroot>
        <prng-seed type="profile">linux</prng-seed>
    </security>
</icecast>
