// Grafana Alloy on the streaming node (#10): host and Icecast metrics,
// pushed to Grafana Cloud (Prometheus remote write), and Icecast logs (#46),
// pushed to Grafana Cloud Logs (Loki).
// Environment: GRAFANA_CLOUD_PROM_URL, GRAFANA_CLOUD_PROM_USER,
// GRAFANA_CLOUD_LOKI_URL, GRAFANA_CLOUD_LOKI_USER, GRAFANA_CLOUD_TOKEN
// (scopes metrics:write and logs:write), NODE_NAME.

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  // Keep the series count well inside the Grafana Cloud free tier.
  disable_collectors = ["arp", "bcache", "bonding", "btrfs", "edac", "fibrechannel", "infiniband", "ipvs", "mdadm", "nfs", "nfsd", "nvme", "powersupplyclass", "rapl", "schedstat", "softnet", "tapestats", "thermal_zone", "udp_queues", "xfs", "zfs"]

  filesystem {
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
  }
}

// The unix exporter labels its targets job="integrations/unix"; the alert
// rules and dashboard use job="node".
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "node"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  job_name        = "node"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

prometheus.scrape "icecast" {
  targets         = [{"__address__" = "icecast-exporter:9100"}]
  job_name        = "icecast"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

// AutoDJ playout service (#66), Compose profile "autodj". Without the
// profile the target does not resolve: up{job="playout"} is 0, and the
// PlayoutDown alert only fires for nodes with AutoDJ stations.
prometheus.scrape "playout" {
  targets         = [{"__address__" = "playout:9101"}]
  job_name        = "playout"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

// One stable instance label per node, whatever the scrape target was.
prometheus.relabel "instance" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("NODE_NAME")
  }
}

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// ---------------------------------------------------------------------------
// Icecast logs (#46). Icecast writes its error log and its access log to
// stdout (icecast.xml); Docker keeps them only until rotation or until the
// container is recreated. Alloy reads them through docker-socket-proxy
// (GET-only allowlist, compose.yaml); the host's /run, with the raw socket,
// is hidden from Alloy.

discovery.docker "icecast" {
  host             = "tcp://docker-socket-proxy:2375"
  refresh_interval = "10s"

  filter {
    name   = "label"
    values = ["com.docker.compose.service=icecast"]
  }
}

// Low-cardinality stream labels only; everything per request goes to
// structured metadata below.
discovery.relabel "icecast_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "job"
    replacement  = "icecast"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("NODE_NAME")
  }
}

loki.source.docker "icecast" {
  host             = "tcp://docker-socket-proxy:2375"
  targets          = discovery.docker.icecast.targets
  relabel_rules    = discovery.relabel.icecast_logs.rules
  refresh_interval = "10s"
  forward_to       = [loki.process.icecast.receiver]
}

loki.process "icecast" {
  forward_to = [loki.write.cloud.receiver]

  // Noise: the container healthcheck every 10 s, the exporter's scrape
  // every 15 s, and Icecast internals logged for every request.
  stage.drop {
    expression          = `"GET /(status-json\.xsl|admin/stats\.xml) HTTP/[0-9.]+" 200 `
    drop_counter_reason = "icecast_polling"
  }

  stage.drop {
    expression          = `event-stream/event_stream_queue event queued|reportxml/reportxml_database_build_report No matching definition`
    drop_counter_reason = "icecast_noise"
  }

  // A listener on a live mount without a source (#113): Icecast looks for a
  // static file of that name (INFO, WARN). Players often send no Accept
  // header, which Icecast cannot parse when it picks the format of its 404
  // page (EROR, harmless, logged for any error page and never names a mount).
  // The access line stays, at level info.
  stage.drop {
    expression          = `fserve/fserve_client_create .*/stations/[A-Za-z0-9-]+/live\.(mp3|opus)|util/util_http_select_best Input string does not parse as KVA`
    drop_counter_reason = "icecast_off_air"
  }

  // Secrets never leave the node. Icecast 2.5 strips query strings from the
  // access log, but other lines may carry a URL, a header, JSON or XML
  // verbatim. Each capture group is replaced.
  // key=value, key: value, "key":"value" for any *pass*, *token*, *secret*,
  // *key* name (access_token, api_key, ICECAST_ADMIN_PASSWORD...).
  stage.replace {
    expression = `(?i)[a-z0-9_.-]*(?:pass(?:word|wd)?|token|secret|key)["']?\s*[:=]\s*["']?([^&\s"'<>,;]+)`
    replace    = "REDACTED"
  }

  // <source-password>value</source-password> and similar XML elements.
  stage.replace {
    expression = `(?i)<[a-z0-9_-]*(?:pass(?:word|wd)?|token|secret|key)[a-z0-9_-]*>([^<]+)<`
    replace    = "REDACTED"
  }

  // scheme://user:password@host, also with an empty user or a "/" in the
  // password.
  stage.replace {
    expression = `(?i)[a-z][a-z0-9+.-]*://[^/\s@:]*:([^\s@]+)@`
    replace    = "REDACTED"
  }

  // Everything after "Authorization", whatever the scheme (Basic, Bearer,
  // Digest with quoted fields...), up to the end of the line.
  stage.replace {
    expression = `(?i)authorization["']?\s*[:=]\s*(.+)`
    replace    = "REDACTED"
  }

  // Error log: [2026-10-14  10:38:50] INFO auth_url/url_add_client client auth ... failed
  stage.match {
    selector = `{job="icecast"} |~ "^\\[\\d{4}-"`

    stage.regex {
      expression = `^\[[^\]]+\] (?P<icecast_level>[A-Z]{4}) (?P<module>[^/ ]+)/(?P<function>\S+) `
    }

    // Mount named in the message, e.g. "/stations/42/live.mp3".
    stage.regex {
      expression = `(?P<mount>/stations/(?P<station>[^/\s"]+)/[^\s"]+)`
    }

    stage.template {
      source   = "level"
      template = `{{ if eq .icecast_level "EROR" }}error{{ else if eq .icecast_level "WARN" }}warn{{ else if eq .icecast_level "DBUG" }}debug{{ else }}info{{ end }}`
    }

    stage.static_labels {
      values = {log_type = "error"}
    }
  }

  // Access log (combined format plus duration in seconds):
  // 172.21.0.1 - 42 [14/Oct/2026:10:38:50 +0000] "PUT /stations/42/live.mp3 HTTP/1.1" 401 775 "-" "Lavf/63.1.101" 0
  stage.match {
    selector = `{job="icecast"} |~ "^\\S+ \\S+ \\S+ \\[\\d{2}/"`

    stage.regex {
      expression = `^\S+ \S+ (?P<user>\S+) \[[^\]]+\] "(?P<method>[A-Z]+) (?P<path>[^\s"]+)[^"]*" (?P<status>(?P<status_class>\d)\d{2}) `
    }

    // Mount from the request path only, never from the Referer.
    stage.regex {
      source     = "path"
      expression = `^(?P<mount>/stations/(?P<station>[^/?]+)/[^?]+)`
    }

    stage.regex {
      source     = "path"
      expression = `^/stations/[^/?]+/(?P<live_mount>live)\.(mp3|opus)$`
    }

    // 4xx (rejected source, wrong admin password) shows as a warning, except
    // a listener's 404 on a live mount: the station is off air (#113).
    stage.template {
      source   = "level"
      template = `{{ if eq .status_class "5" }}error{{ else if and (eq .status "404") .live_mount (or (eq .method "GET") (eq .method "HEAD")) }}info{{ else if eq .status_class "4" }}warn{{ else }}info{{ end }}`
    }

    stage.static_labels {
      values = {log_type = "access"}
    }
  }

  stage.labels {
    values = {level = ""}
  }

  stage.structured_metadata {
    values = {
      module   = "",
      function = "",
      method   = "",
      status   = "",
      user     = "",
      mount    = "",
      station  = "",
    }
  }
}

loki.write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
