# Copy to .env and replace every value. Generate with: openssl rand -hex 24
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
# Optional; generated at startup when unset.
# ICECAST_RELAY_PASSWORD=
# Optional host port for local runs (default 8000).
# ICECAST_PORT=8000
# Optional public hostname reported by Icecast (e.g. listen.example.com).
# ICECAST_HOSTNAME=

# Source auth endpoint (see docs/source-auth.md). Defaults to the local stub.
# ICECAST_SOURCE_AUTH_URL=https://api.example.com/icecast/source
ICECAST_SOURCE_AUTH_USER=icecast
ICECAST_SOURCE_AUTH_PASSWORD=

# Local stub only: station-id:password pairs allowed to publish.
STUB_STATIONS=42:change-me
